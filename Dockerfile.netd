# syntax=docker/dockerfile:1
# termoak-netd image (the "with networks" build): runs next to the server
# image, sharing a volume for its socket (docker-compose.yml, profile
# "networks"). A static Go binary in user space: no root, no TUN device, no
# extra capabilities. Both images run as the system user `termoak` (same
# uid), so the socket stays 0600.
FROM golang:1.27-bookworm AS build
WORKDIR /src
COPY netd/go.mod netd/go.sum ./
RUN go mod download
COPY netd ./
ARG VERSION=dev
# TAGS=tailscale (the default) builds in the Tailscale/Headscale backend
# (tsnet); TAGS="" leaves it out (WireGuard only, a smaller binary).
ARG TAGS=tailscale
RUN CGO_ENABLED=0 go build -trimpath -tags "${TAGS}" \
      -ldflags "-s -w -X github.com/TermoakSSH/server/netd/internal/netd.Version=${VERSION}" \
      -o /out/termoak-netd ./cmd/termoak-netd

FROM debian:bookworm-slim
# ca-certificates: tsnet talks HTTPS to Tailscale's (or a Headscale)
# control server and DERP relays.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --home /var/lib/termoak --create-home termoak \
 && mkdir -p /run/termoak-netd /var/lib/termoak-netd \
 && chown termoak:termoak /run/termoak-netd /var/lib/termoak-netd \
 && chmod 0750 /run/termoak-netd && chmod 0700 /var/lib/termoak-netd
COPY --from=build /out/termoak-netd /usr/local/bin/
USER termoak
# The state volume keeps persistent Tailscale nodes (ephemeral: false).
VOLUME ["/run/termoak-netd", "/var/lib/termoak-netd"]
ENV TERMOAK_NETD_SOCKET=/run/termoak-netd/netd.sock \
    TERMOAK_NETD_STATE_DIR=/var/lib/termoak-netd \
    TERMOAK_NETD_IDLE=15m \
    GOMEMLIMIT=384MiB
ENTRYPOINT ["/usr/local/bin/termoak-netd"]
